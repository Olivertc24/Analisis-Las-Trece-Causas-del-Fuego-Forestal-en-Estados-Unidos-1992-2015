# ==============================================================================
# PLANTILLA DE CREDENCIALES  -  ESTE ARCHIVO SI SE VERSIONA
# ==============================================================================
#
# Copiar a `.streamlit/secrets.toml` y sustituir el valor. Ese archivo NO se
# versiona: esta excluido en .gitignore.
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# DE DONDE SALE EL TOKEN
# ----------------------
# app.motherduck.com -> Settings -> Access tokens -> Create token
#
# Debe ser un *service token*, no el token de sesion personal que genera el
# flujo de navegador: el de sesion caduca y no sirve para un aplicativo
# desplegado.
#
# EN STREAMLIT COMMUNITY CLOUD
# ----------------------------
# No se sube ningun archivo. El contenido de `secrets.toml` se pega en
# Settings -> Secrets del aplicativo ya desplegado.
# ==============================================================================

motherduck_token = "pega_aqui_tu_service_token_de_motherduck"

# Base que consume el aplicativo. Se deja explicita para no tener el nombre
# escrito dentro del codigo.
motherduck_database = "fpa_normalizada"

# Cadena de conexion de PostgreSQL en Supabase, para la carga de la tabla
# original y el cuestionario SQL. Se obtiene en:
#   Project Settings -> Database -> Connection string, pestana URI
supabase_db_url = "pega_aqui_la_cadena_de_conexion_de_supabase"
